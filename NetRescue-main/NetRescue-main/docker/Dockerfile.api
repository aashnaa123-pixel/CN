FROM python:3.11-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first (cache layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY netrescue/ ./netrescue/
COPY apps/api/ ./apps/api/
COPY pyproject.toml .

# Create schema and start API
CMD ["sh", "-c", "python -c 'from netrescue.core.db import create_all_tables; create_all_tables()' && uvicorn apps.api.main:app --host ${API_BIND_HOST:-0.0.0.0} --port ${PORT:-${API_BIND_PORT:-8000}}"]
