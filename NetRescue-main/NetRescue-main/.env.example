# NetRescue — environment variables
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql+psycopg://netrescue:netrescue@localhost:5432/netrescue

# --- API ---
API_BIND_HOST=127.0.0.1
API_BIND_PORT=8000
API_SECRET_KEY=change-me-in-production
# Required before binding to anything but loopback: roles above readonly then need
# the matching X-NetRescue-Token header. Generate a long random value.
API_AUTH_TOKEN=

# --- TLS / mTLS ---
TLS_CA_CERT=certs/ca.crt
TLS_NODE_CERT=certs/node.crt
TLS_NODE_KEY=certs/node.key

# --- Feature flags ---
ENABLE_EMULATION=true
ENABLE_SECURITY=true

# --- PostgreSQL (Docker Compose only) ---
# These sample credentials are for local development only; use unique ones anywhere shared.
POSTGRES_USER=netrescue
POSTGRES_PASSWORD=netrescue
POSTGRES_DB=netrescue

# --- Browser access / hosted demo (see docs/DEPLOYMENT.md) ---
# Exact frontend origin(s), comma-separated, no wildcard, no path.
CORS_ORIGINS=
# Keep localhost/127.0.0.1 origins allowed for local development; set false on a hosted API.
CORS_ALLOW_LOOPBACK=true
# true = tokenless callers get operator on the simulation routes only (public demo).
PUBLIC_DEMO=false
